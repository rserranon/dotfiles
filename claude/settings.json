{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(rg:*)",
      "Bash(bat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ],
    "deny": []
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "dotfiles-tools@local-dotfiles": true,
    "wiki@llm-wiki": true,
    "superpowers@claude-plugins-official": true,
    "nono@always-further": true
  },
  "extraKnownMarketplaces": {
    "local-dotfiles": {
      "source": {
        "source": "directory",
        "path": "/Users/robert/.claude/local-marketplace"
      }
    },
    "llm-wiki": {
      "source": {
        "source": "github",
        "repo": "nvk/llm-wiki"
      }
    }
  },
  "effortLevel": "medium",
  "editorMode": "vim"
}
